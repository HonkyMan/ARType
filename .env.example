# Copy to .env (chmod 600). DOMAIN must resolve to the server before launch.
COMPOSE_FILE=compose.yaml
DOMAIN=translate.example.com
# Generate a URL-safe random password: openssl rand -hex 32
POSTGRES_PASSWORD=
ADMIN_EMAILS=
# OAuth Web application; redirect URI: https://DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# JSON; alias is selected per organization. Keep quotes around the entire value.
PROVIDER_KEYS='{"main":""}'
